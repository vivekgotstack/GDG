# Spring Boot reads exported environment variables, not this file automatically.
# For your VPS, set these through your process manager or Docker env_file.
PORT=8080
BIND_ADDRESS=127.0.0.1
SPRING_PROFILES_ACTIVE=local
# Use postgres profile and fill these for persistent PostgreSQL instead of local H2.
# DB_URL=jdbc:postgresql://localhost:5432/meetgrid
# DB_USERNAME=meetgrid
# DB_PASSWORD=replace-with-your-database-password
APP_URL=http://localhost:3000
SESSION_TIMEOUT=8h
# Set true when the browser-facing frontend uses HTTPS.
SESSION_COOKIE_SECURE=false
DEMO_RESET_ENABLED=false

# Optional billing. Leave blank to keep paid checkout unavailable.
# Secret keys stay ONLY on the backend.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STUDIO=
STRIPE_PRICE_SCALE=
BILLING_CURRENCY=USD
# Display amounts in whole currency units; Stripe Price must match.
PLAN_FREE_NAME=Free
PLAN_FREE_MONTHLY_PRICE=0
PLAN_FREE_MEMBERS=5
PLAN_FREE_ROOMS=2
PLAN_FREE_BOOKINGS=10
PLAN_STUDIO_NAME=Studio
PLAN_STUDIO_MONTHLY_PRICE=19
PLAN_STUDIO_MEMBERS=25
PLAN_STUDIO_ROOMS=10
PLAN_STUDIO_BOOKINGS=100
PLAN_SCALE_NAME=Scale
PLAN_SCALE_MONTHLY_PRICE=59
PLAN_SCALE_MEMBERS=100
PLAN_SCALE_ROOMS=50
PLAN_SCALE_BOOKINGS=1000
