# Next.js server: never put backend credentials in NEXT_PUBLIC variables.
API_BASE_URL=http://127.0.0.1:8080
PROXY_SHARED_SECRET=REPLACE_WITH_SAME_RANDOM_SECRET_AS_BACKEND
TRUST_PROXY_IP_HEADER=false
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=REPLACE_CLERK_PUBLISHABLE_KEY
CLERK_SECRET_KEY=REPLACE_CLERK_SECRET_KEY
# Optional public branding, baked into the frontend build:
NEXT_PUBLIC_APP_NAME=MeetGrid
NEXT_PUBLIC_APP_TAGLINE=Good company. Better coordination.
NEXT_PUBLIC_SUPPORT_EMAIL=vivekgotstack@gmail.com
NEXT_PUBLIC_SUPPORT_PHONE=8303165648
NEXT_PUBLIC_COMPANY_NAME=StackOrcs
NEXT_PUBLIC_COMPANY_URL=https://stackorcs.com
