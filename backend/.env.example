# Spring Boot reads exported environment variables, not this file automatically.
# For your VPS, set these through your process manager or Docker env_file.
PORT=8080
BIND_ADDRESS=127.0.0.1
SPRING_PROFILES_ACTIVE=local
# Use postgres profile and fill these for persistent PostgreSQL instead of local H2.
# DB_URL=jdbc:postgresql://localhost:5432/meetgrid
# DB_USERNAME=meetgrid
# DB_PASSWORD=replace-with-your-database-password
APP_URL=http://localhost:3000
SESSION_TIMEOUT=8h
# Set true when the browser-facing frontend uses HTTPS.
SESSION_COOKIE_SECURE=false
DEMO_RESET_ENABLED=false
# Reserved owner identifier. Bootstrap runs only with a supplied secret password.
ADMIN_EMAIL=vivekni1224@nigam
ADMIN_BOOTSTRAP_PASSWORD=

# Optional billing. Leave blank to keep paid checkout unavailable.
# Secret keys stay ONLY on the backend.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_STUDIO=
STRIPE_PRICE_SCALE=
# Plan labels, USD prices, descriptions, and enforced limits live in the database.
# Change them at /app/admin-plans. Initial monthly prices: Gather 7, Studio 12, Collective 20.
# Configure matching monthly USD Stripe prices; checkout rejects mismatched prices.
